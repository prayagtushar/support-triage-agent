# Working docs stay local: the build guide, sprint plan, scratch notes, and
# docs/study/ (interview prep and talking points) are for me, not readers.
# The deployment runbook and the failure analysis are published, because the
# README points at them and they are part of what makes the project reviewable.
docs/*
!docs/DEPLOY.md
!docs/failure_analysis.md

# Environment files
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Node / Next.js (ui/ has its own .gitignore; this catches strays)
node_modules/
.next/

# OS and editors
.DS_Store
.idea/
.vscode/

# Downloaded corpus data
api/data/

# Playwright MCP scratch
.playwright-mcp/

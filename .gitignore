# Working docs stay local; the runbook and failure analysis are published.
docs/*
!docs/DEPLOY.md
!docs/failure_analysis.md
!docs/EVAL_CARD.md
!docs/VOICE.md

# Environment files
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Node / Next.js (ui/ has its own .gitignore; this catches strays)
node_modules/
.next/

# OS and editors
.DS_Store
.idea/
.vscode/

# Downloaded corpus data
api/data/

# Playwright MCP scratch
.playwright-mcp/

# Synthesised prompt audio for the voice benchmark. Regenerated by `make voice-audio`
# from the golden set, so it is a cache rather than a source: ~400KB a ticket, and the
# 60-ticket set would be 24MB of derived wav in git. The reports beside it are kept.
api/evals/voice/audio/

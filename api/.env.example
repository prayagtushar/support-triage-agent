# Copy to .env and fill in the API keys. Every value maps to a field on
# Settings in app/config.py; nothing else reads the environment directly.

APP_ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/triage

# sarvam: dashboard.sarvam.ai | gemini: aistudio.google.com/apikey
# groq: console.groq.com/keys | openrouter: openrouter.ai/keys (optional)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v1

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# pinned versions, never -latest aliases: eval numbers must stay reproducible
CLASSIFIER_PROVIDER=openrouter
CLASSIFIER_MODEL=meta-llama/llama-3.3-70b-instruct
CLASSIFIER_TEMPERATURE=0.0
CLASSIFIER_MAX_TOKENS=1024

DRAFTER_PROVIDER=sarvam
DRAFTER_MODEL=sarvam-105b
DRAFTER_TEMPERATURE=0.3
# sarvam-105b reasons first and bills it as completion tokens
DRAFTER_MAX_TOKENS=4096

# must differ from the drafter provider
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-3.5-flash-lite
JUDGE_TEMPERATURE=0.0
JUDGE_MAX_TOKENS=2048

# changing EMBEDDING_DIM means a migration and a full re-embed
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536

LLM_TIMEOUT_SECONDS=60
LLM_MAX_TRANSPORT_RETRIES=2
LLM_MAX_VALIDATION_RETRIES=1

# free-tier ceilings, enforced client-side
GEMINI_RPM=15
# batchEmbedContents bills each item as a request; this is items per minute
GEMINI_EMBED_RPM=100
GROQ_RPM=30
# Groq free tier is also capped at 100k tokens per DAY, which one eval run
# would consume half of. Kept configured but not used by any node.
GROQ_TPM=12000
SARVAM_RPM=60
OPENROUTER_RPM=20

RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=5
RRF_K=60
WEAK_RETRIEVAL_FLOOR=0.45

# routing policy: config, not code. re-tuned from calibration in M8
ROUTE_AUTO_REPLY_THRESHOLD=0.85
ROUTE_REVIEW_THRESHOLD=0.55

# must sum to 1.0
COMPOSITE_WEIGHT_JUDGE=0.5
COMPOSITE_WEIGHT_CLASSIFIER=0.3
COMPOSITE_WEIGHT_RETRIEVAL=0.2

# empty keys disable tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

EVAL_CONCURRENCY=4

# rate as of 2026-07-31
USD_TO_INR=87.0

HF_TOKEN=

APP_ENV=dev

# The variables below are added in later phases of the build.
# Uncomment and fill them in as you reach the matching phase.

# Phase 1: database
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/triage

# Phase 2: model providers
# SARVAM_API_KEY=
# SARVAM_BASE_URL=https://api.sarvam.ai/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1
# CLASSIFIER_MODEL=qwen3:14b
# DRAFTER_MODEL=sarvam-30b

# Phase 7: observability
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
